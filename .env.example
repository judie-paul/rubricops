DATABASE_URL="postgresql://rubricops:rubricops-local@127.0.0.1:55432/rubricops?schema=public"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"
