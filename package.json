{
  "name": "rubricops",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit.test.ts tests/queue.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "results": "tsx --env-file=.env scripts/results.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.39.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
